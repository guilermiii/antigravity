# ==============================================================================
# MODELO DE CONFIGURAÇÃO DE AMBIENTE (PÚBLICO / SEGURO PARA SUBIR NO GITHUB)
# ==============================================================================
# Copie este arquivo para ".env" e preencha as variáveis com suas credenciais:
#   cp .env.example .env
#
# NUNCA envie o arquivo ".env" com credenciais reais para o controle de versão!
# O arquivo ".env" já está listado no .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação e Ambiente
# ------------------------------------------------------------------------------
# Ambiente de execução: development, staging ou production
ENVIRONMENT=development
DEBUG=True
APP_VERSION=2.2.0-dev

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=users_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# String de conexão SQLAlchemy usada pela API FastAPI
# Para Docker Compose, use o host "db" (postgresql://postgres:postgrespassword@db:5432/users_db)
# Para execução local direta no host, use "localhost":
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/users_db

# ------------------------------------------------------------------------------
# 3. Segurança, Criptografia e Sessão JWT (PyJWT)
# ------------------------------------------------------------------------------
# Chave secreta de pelo menos 32 bytes (64 caracteres hexadecimais) usada para
# assinatura HMAC-SHA256 de tokens de sessão e states anti-CSRF.
# Gere uma nova chave forte com o comando:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_at_least_32_bytes_long_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. URLs e Integração Frontend / CORS
# ------------------------------------------------------------------------------
# Em produção com DuckDNS:
FRONTEND_URL=https://guilermiii.duckdns.org
VITE_API_URL=https://guilermiii.duckdns.org

# Para desenvolvimento local (sem proxy reverso):
# FRONTEND_URL=http://localhost:3000
# VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. Provedor OAuth 2.0: GitHub
# ------------------------------------------------------------------------------
# 1. Acesse: https://github.com/settings/developers
# 2. OAuth Apps -> "New OAuth App" ou edite existente
# 3. Homepage URL: https://guilermiii.duckdns.org
# 4. Authorization callback URL: https://guilermiii.duckdns.org/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=https://guilermiii.duckdns.org/auth/github/callback

# ------------------------------------------------------------------------------
# 6. Provedor OAuth 2.0: Google / Gmail
# ------------------------------------------------------------------------------
# 1. Acesse o Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Em "Credenciais" -> "ID do cliente OAuth" -> Aplicativo da Web
# 3. Origens JavaScript autorizadas:
#      https://guilermiii.duckdns.org
#      http://localhost:3000 (para dev local)
# 4. URIs de redirecionamento autorizados:
#      https://guilermiii.duckdns.org/auth/google/callback
#      http://localhost:8000/auth/google/callback (para dev local)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://guilermiii.duckdns.org/auth/google/callback
